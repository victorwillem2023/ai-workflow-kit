{
  "name": "{{PROJECT}}",
  "roots": ["src", "tests", "scripts", "tools", "workflow"],
  "skipFiles": [],
  "tests": "{tests,workflow/tests}/**/*.test.ts",
  "ignoreChanged": ["docs/**", "**/*.md", ".claude/**", "workflow/specs/**", ".gitignore", "workflow/config.json"],
  "commands": {
    "typecheck": "npm run typecheck",
    "testAll": "npm test",
    "testFiles": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=./workflow/tools/lib/quiet-reporter.mjs"
  },
  "map": { "out": "docs/MAP.md", "folders": ["src/**"] },
  "size": { "maxLines": 400, "include": ["src/**/*.ts", "src/**/*.tsx", "tools/**/*.mjs"] },
  "functions": { "maxLines": 60, "maxDepth": 4, "include": ["src/**/*.ts", "src/**/*.tsx"] },
  "untested": { "include": ["src/**/*.ts", "src/**/*.tsx"], "ignore": ["src/**/main.ts", "src/**/index.ts", "src/**/*.d.ts", "src/variants/**"] },
  "ui": { "boards": "html", "variants": "src/variants", "tokens": "src/web/styles.css" },
  "ratchets": [
    {
      "name": "escape hatches",
      "include": ["src/**/*.ts", "src/**/*.tsx"],
      "patterns": [":\\s*any\\b", "\\bas any\\b", "@ts-ignore", "@ts-expect-error", "catch\\s*(\\([^)]*\\))?\\s*\\{\\s*\\}", "\\b(TODO|FIXME)\\b(?!.*#\\d)"],
      "say": "One more way around a check (any, @ts-ignore, an empty catch, a TODO with no card number): give it its real type, handle the error, or name the card (TODO #12)"
    }
  ],
  "budget": { "CLAUDE.md": 14500, "src/**/CLAUDE.md": 4500 },
  "testSeconds": 120,
  "scope": "advice",
  "copies": { "minLines": 6, "tests": ["tests/**/*.test.ts"] },
  "naming": {
    "files": [
      { "glob": "src/**/*.tsx", "style": "pascal", "except": ["main.tsx", "index.tsx"] },
      { "glob": "src/**/*.ts", "style": "kebab" },
      { "glob": "tests/**/*.ts", "style": "kebab" }
    ],
    "exports": ["src/**/*.ts", "src/**/*.tsx"],
    "sorted": [{ "file": "package.json", "keys": ["dependencies", "devDependencies"] }],
    "resources": [{ "glob": "infra/**/*.tf", "pattern": "^{{PREFIX}}-(dev|test|uat|staging|prod)-[a-z]+[0-9]*-[a-z0-9-]+$", "say": "<app>-<env>-<place>-<part> (docs/CONVENTIONS.md)" }]
  },
  "performance": {
    "files": ["dist/assets/*.js", "dist/assets/*.css"],
    "maxKb": 250,
    "goals": { "p95ms": 300, "errorRate": 0.01 },
    "load": { "paths": ["/health"], "users": 20, "duration": "2m" }
  },
  "sensitive": {
    "paths": []
  },
  "data": { "migrations": ["**/migrations/**/*.sql", "**/migrations/*.{ts,js,py,go}", "drizzle/**/*.sql", "alembic/versions/*.py"] },
  "checks": [
    { "name": "lint", "command": "npx --no-install biome check --no-errors-on-unmatched .", "when": ["src/**", "tests/**", "biome.json"] },
    { "name": "leaks", "command": "node workflow/tools/leaks.mjs", "all": true },
    { "name": "unused", "command": "node workflow/tools/unused.mjs", "all": true },
    { "name": "audit", "command": "npm audit --audit-level=high", "all": true },
    { "name": "infra", "command": "node workflow/tools/infracheck.mjs", "when": ["deploy/helm/**", "infra/**"] },
    { "name": "page weight", "command": "node workflow/tools/perfbudget.mjs", "when": ["src/web/**", "package.json", "vite.config.*", "next.config.*"] }
  ],
  "docs": {
    "include": ["README.md", "CLAUDE.md", "src/**/CLAUDE.md", "docs/*.md", "workflow/guides/*.md", "docs/run/*.md", "docs/market/*.md", "docs/company/*.md", "docs/guide/*.md", "docs/code/*.md"],
    "exclude": ["docs/run/INFRA-MAP.md", "docs/MAP.md", "docs/README.md"]
  },
  "boundaries": [
    {
      "name": "core is pure",
      "from": "src/core/**",
      "forbid": ["src/web/**", "src/server/**"],
      "forbidNode": true
    },
    { "name": "variants are throwaway: the app never depends on them", "from": "src/{core,web,server}/**", "forbid": ["src/variants/**"], "except": ["src/**/main.{ts,tsx}"] },
    { "name": "variants use made-up data, never the server", "from": "src/variants/**", "forbid": ["src/server/**"] }
  ],
  "security": {
    "code": "src/",
    "server": "src/server/",
    "inputFolders": ["src/core/", "src/server/"],
    "signIn": false,
    "domains": [],
    "egress": [],
    "ipRules": []
  },
  "commits": { "notes": "own" },
  "session": {
    "prefix": "{{PREFIX}}",
    "firstPort": 8788,
    "mainPort": 8787,
    "flow": "direct",
    "env": {}
  },
  "board": {
    "owner": "{{OWNER}}",
    "repo": "{{REPO}}",
    "project": 0,
    "field": "Status",
    "columns": ["Backlog", "Needs a board or decision", "Ready", "In progress", "Waiting for your check", "Blocked", "Done"],
    "types": ["ui", "feature", "bug", "workflow", "spike"],
    "labels": {
      "areas": ["area: UI", "area: Backend", "area: Workflow and docs"],
      "value": ["value: high", "value: medium", "value: low"],
      "effort": ["effort: small", "effort: medium", "effort: large", "effort: unknown"],
      "feasibility": ["feasibility: high", "feasibility: medium", "feasibility: low"],
      "milestone": ["first version"]
    }
  },
  "harness": {
    "opencode": {
      "model": "deepseek/deepseek-v4-pro",
      "cheapModel": "opencode/glm-5.3-flash-free",
      "smallModel": "opencode/deepseek-v4.1-flash-free",
      "exploreModel": "deepseek/deepseek-flash"
    },
    "private": [".env", "data/"],
    "agentsMd": false
  },
  "baseline": "workflow/tools/baseline.json",
  "failTailLines": 60
}
