{
  "name": "{{PROJECT}}",
  "roots": ["src", "tests", "scripts", "tools"],
  "skipFiles": [],
  "tests": "tests/**/*.test.ts",
  "ignoreChanged": ["docs/**", "**/*.md", ".claude/**", "specs/**", ".gitignore", "workflow.config.json"],
  "commands": {
    "typecheck": "npm run typecheck",
    "testAll": "npm test",
    "testFiles": "node --disable-warning=ExperimentalWarning --import tsx --test --test-reporter=./tools/workflow/lib/quiet-reporter.mjs"
  },
  "map": { "out": "docs/MAP.md", "folders": ["src/**"] },
  "size": { "maxLines": 400, "include": ["src/**/*.ts", "src/**/*.tsx", "tools/**/*.mjs"] },
  "functions": { "maxLines": 60, "maxDepth": 4, "include": ["src/**/*.ts", "src/**/*.tsx"] },
  "untested": { "include": ["src/**/*.ts", "src/**/*.tsx"], "ignore": ["src/**/main.ts", "src/**/index.ts", "src/**/*.d.ts", "src/variants/**"] },
  "ui": { "boards": "html", "variants": "src/variants" },
  "ratchets": [
    {
      "name": "escape hatches",
      "include": ["src/**/*.ts", "src/**/*.tsx"],
      "patterns": [":\\s*any\\b", "\\bas any\\b", "@ts-ignore", "@ts-expect-error", "catch\\s*(\\([^)]*\\))?\\s*\\{\\s*\\}", "\\b(TODO|FIXME)\\b(?!.*#\\d)"],
      "say": "One more way around a check (any, @ts-ignore, an empty catch, a TODO with no card number): give it its real type, handle the error, or name the card (TODO #12)"
    }
  ],
  "budget": { "CLAUDE.md": 14000, "src/**/CLAUDE.md": 4500 },
  "testSeconds": 120,
  "scope": "advice",
  "copies": { "minLines": 6, "tests": ["tests/**/*.test.ts"] },
  "checks": [
    { "name": "lint", "command": "npx --no-install biome check src tests", "when": ["src/**", "tests/**", "biome.json"] },
    { "name": "unused", "command": "npx --no-install knip --no-progress", "all": true },
    { "name": "audit", "command": "npm audit --audit-level=high", "all": true }
  ],
  "docs": {
    "include": ["README.md", "CLAUDE.md", "src/**/CLAUDE.md", "docs/*.md", "docs/guide/*.md", "docs/code/*.md"],
    "exclude": ["docs/MAP.md"]
  },
  "boundaries": [
    {
      "name": "core is pure",
      "from": "src/core/**",
      "forbid": ["src/web/**", "src/server/**"],
      "forbidNode": true
    },
    { "name": "variants are throwaway: the app never depends on them", "from": "src/{core,web,server}/**", "forbid": ["src/variants/**"], "except": ["src/**/main.{ts,tsx}"] },
    { "name": "variants use made-up data, never the server", "from": "src/variants/**", "forbid": ["src/server/**"] }
  ],
  "security": {
    "code": "src/",
    "server": "src/server/",
    "inputFolders": ["src/core/", "src/server/"]
  },
  "session": {
    "prefix": "{{PREFIX}}",
    "firstPort": 8788,
    "mainPort": 8787,
    "flow": "direct",
    "env": {}
  },
  "board": {
    "owner": "{{OWNER}}",
    "repo": "{{REPO}}",
    "project": 0,
    "field": "Status",
    "columns": ["Backlog", "Needs a board or decision", "Ready", "In progress", "Waiting for your check", "Blocked", "Done"],
    "types": ["ui", "feature", "bug", "workflow"],
    "labels": {
      "areas": ["area: UI", "area: Backend", "area: Workflow and docs"],
      "effort": ["effort: small", "effort: medium", "effort: large", "effort: unknown"],
      "feasibility": ["feasibility: high", "feasibility: medium", "feasibility: low"]
    }
  },
  "harness": {
    "opencode": {
      "model": "deepseek/deepseek-v4-pro",
      "cheapModel": "opencode/glm-5.3-flash-free",
      "smallModel": "opencode/deepseek-v4.1-flash-free",
      "exploreModel": "deepseek/deepseek-flash"
    },
    "private": [".env", "data/"],
    "agentsMd": false
  },
  "baseline": "tools/workflow/baseline.json",
  "failTailLines": 60
}
