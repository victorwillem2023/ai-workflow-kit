{
  "permissions": {
    "allow": [
      "Bash(npm run gate:*)",
      "Bash(npm test:*)",
      "Bash(npm run map:*)",
      "Bash(npm run harness:*)",
      "Bash(node workflow/tools/gate.mjs:*)",
      "Bash(node workflow/tools/map.mjs:*)",
      "Bash(npm run board:*)",
      "Bash(node workflow/tools/board.mjs:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree:*)",
      "Bash(node workflow/scripts/session.mjs:*)",
      "Bash(npm run updates:*)",
      "Bash(node workflow/tools/updates.mjs:*)",
      "Bash(npm run secops:*)",
      "Bash(node workflow/tools/secops.mjs:*)",
      "Bash(npm run setup-check:*)",
      "Bash(npm run access:*)",
      "Bash(node workflow/tools/access.mjs:*)",
      "Bash(npm run changelog:*)",
      "Bash(node workflow/tools/changelog.mjs:*)",
      "Bash(node workflow/tools/perfbudget.mjs:*)",
      "Bash(npm run retro:*)",
      "Bash(node workflow/tools/retro.mjs:*)",
      "Bash(npm run load:*)",
      "Bash(node workflow/tools/load.mjs:*)",
      "Bash(npm run infra-check:*)",
      "Bash(node workflow/tools/infracheck.mjs:*)",
      "Bash(npm run infra-plan:*)",
      "Bash(npm run drill:*)",
      "Bash(node workflow/tools/drill.mjs:*)",
      "Bash(npm run launch-check:*)",
      "Bash(node workflow/tools/launchcheck.mjs:*)",
      "Bash(npm run costs:*)",
      "Bash(node workflow/tools/costs.mjs:*)",
      "Bash(npm run cost:*)",
      "Bash(node workflow/tools/sessioncost.mjs:*)",
      "Bash(npm run shipped:*)",
      "Bash(node workflow/tools/shipped.mjs:*)",
      "Bash(npm run coverage:*)",
      "Bash(node workflow/tools/coverage.mjs:*)"
    ],
    "deny": [
      "Bash(npm run signoff:*)",
      "Bash(node workflow/tools/signoff.mjs:*)",
      "Bash(npm run infra-apply:*)",
      "Bash(node workflow/tools/infraplan.mjs --apply:*)",
      "Bash(npm run infra-plan * --allow-destroy*)",
      "Bash(node workflow/tools/infraplan.mjs * --allow-destroy*)",
      "Bash(tofu apply:*)",
      "Bash(terraform apply:*)",
      "Bash(pulumi up:*)",
      "Edit(docs/company/SIGNOFFS.md)",
      "Write(docs/company/SIGNOFFS.md)",
      "Edit(docs/company/SIGNERS.md)",
      "Write(docs/company/SIGNERS.md)",
      "Edit(workflow/levels.json)",
      "Write(workflow/levels.json)",
      "Bash(git push --no-verify:*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --force:*)",
      "Bash(git push * --force*)",
      "Bash(git push -f:*)",
      "Bash(git push * -f*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node workflow/scripts/stop-points.mjs --prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node workflow/scripts/stop-points.mjs --tool"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node workflow/scripts/stop-points.mjs --edit"
          }
        ]
      }
    ]
  }
}
