{
  "permissions": {
    "allow": [
      "Bash(npm run gate:*)",
      "Bash(npm test:*)",
      "Bash(npm run map:*)",
      "Bash(npm run harness:*)",
      "Bash(node tools/workflow/gate.mjs:*)",
      "Bash(node tools/workflow/map.mjs:*)",
      "Bash(npm run board:*)",
      "Bash(node tools/workflow/board.mjs:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git worktree:*)",
      "Bash(node scripts/session.mjs:*)",
      "Bash(npm run updates:*)",
      "Bash(node tools/workflow/updates.mjs:*)",
      "Bash(npm run secops:*)",
      "Bash(node tools/workflow/secops.mjs:*)",
      "Bash(npm run setup-check:*)",
      "Bash(npm run access:*)",
      "Bash(node tools/workflow/access.mjs:*)",
      "Bash(npm run changelog:*)",
      "Bash(node tools/workflow/changelog.mjs:*)",
      "Bash(node tools/workflow/perfbudget.mjs:*)",
      "Bash(npm run retro:*)",
      "Bash(node tools/workflow/retro.mjs:*)",
      "Bash(npm run load:*)",
      "Bash(node tools/workflow/load.mjs:*)",
      "Bash(npm run infra-check:*)",
      "Bash(node tools/workflow/infracheck.mjs:*)",
      "Bash(npm run infra-plan:*)",
      "Bash(npm run drill:*)",
      "Bash(node tools/workflow/drill.mjs:*)",
      "Bash(npm run launch-check:*)",
      "Bash(node tools/workflow/launchcheck.mjs:*)",
      "Bash(npm run costs:*)",
      "Bash(node tools/workflow/costs.mjs:*)"
    ],
    "deny": [
      "Bash(npm run signoff:*)",
      "Bash(node tools/workflow/signoff.mjs:*)",
      "Bash(npm run infra-apply:*)",
      "Bash(node tools/workflow/infraplan.mjs --apply:*)",
      "Bash(npm run infra-plan * --allow-destroy*)",
      "Bash(node tools/workflow/infraplan.mjs * --allow-destroy*)",
      "Bash(tofu apply:*)",
      "Bash(terraform apply:*)",
      "Bash(pulumi up:*)",
      "Edit(docs/company/SIGNOFFS.md)",
      "Write(docs/company/SIGNOFFS.md)",
      "Bash(git push --no-verify:*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push --force:*)",
      "Bash(git push * --force*)",
      "Bash(git push -f:*)",
      "Bash(git push * -f*)",
      "Bash(git -c core.hooksPath*)",
      "Bash(git config core.hooksPath*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/stop-points.mjs --prompt"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/stop-points.mjs --tool"
          }
        ]
      }
    ]
  }
}
