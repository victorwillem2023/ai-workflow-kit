{
  "ts": {
    "name": "TypeScript",
    "needs": "npm i -D tsx typescript @types/node knip @biomejs/biome",
    "tests": "tests/*.test.ts"
  },
  "rust": {
    "name": "Rust",
    "needs": "rustup (cargo, clippy), then: cargo install cargo-machete cargo-audit --locked",
    "config": {
      "code": [
        ".rs",
        ".mjs"
      ],
      "tests": "tests/**/*.rs",
      "testPicking": false,
      "commands": {
        "typecheck": "cargo check --all-targets && cargo clippy --all-targets -- -D warnings",
        "testAll": "cargo test",
        "testFiles": "cargo test"
      },
      "size": {
        "maxLines": 400,
        "include": [
          "src/**/*.rs",
          "tools/**/*.mjs"
        ]
      },
      "functions": {
        "maxLines": 60,
        "include": [
          "src/**/*.rs"
        ],
        "maxDepth": 4
      },
      "boundaries": [
        {
          "name": "core is pure",
          "from": "src/core/**",
          "forbid": [
            "src/web/**",
            "src/server/**"
          ],
          "forbidUse": [
            "std::fs",
            "std::net::TcpStream",
            "std::net::TcpListener",
            "std::net::UdpSocket",
            "std::process",
            "tokio",
            "reqwest"
          ]
        }
      ],
      "checks": [
        {
          "name": "unused",
          "command": "cargo machete",
          "all": true
        },
        {
          "name": "audit",
          "command": "cargo audit",
          "all": true
        }
      ],
      "ratchets": [
        {
          "name": "escape hatches",
          "include": [
            "src/**/*.rs"
          ],
          "patterns": [
            "#\\[allow\\(",
            "\\bunsafe\\s*\\{",
            "\\btodo!\\(",
            "\\bunimplemented!\\(",
            "\\b(TODO|FIXME)\\b(?!.*#\\d)"
          ],
          "say": "One more way around a check (#[allow], unsafe, todo!(), a TODO with no card number): fix what the compiler says, or name the card (TODO #12)"
        }
      ],
      "copies": {
        "minLines": 6
      }
    },
    "scripts": {
      "test": "cargo test",
      "test:full": "cargo test -- --nocapture",
      "typecheck": "cargo check --all-targets && cargo clippy --all-targets -- -D warnings"
    },
    "gitignore": [
      "target/"
    ],
    "ci": [
      "- uses: dtolnay/rust-toolchain@stable",
      "  with:",
      "    components: clippy",
      "- uses: taiki-e/install-action@v2",
      "  with:",
      "    tool: cargo-machete,cargo-audit"
    ],
    "dependabot": "cargo"
  },
  "python": {
    "name": "Python",
    "needs": "uv (https://docs.astral.sh/uv/), then: uv sync",
    "config": {
      "code": [
        ".py",
        ".mjs"
      ],
      "tests": "tests/**/test_*.py",
      "testPicking": false,
      "commands": {
        "typecheck": "uv run ruff check . && uv run mypy src",
        "testAll": "uv run pytest -q",
        "testFiles": "uv run pytest -q"
      },
      "size": {
        "maxLines": 400,
        "include": [
          "src/**/*.py",
          "tools/**/*.mjs"
        ]
      },
      "boundaries": [
        {
          "name": "core is pure",
          "from": "src/**/core/**",
          "forbid": [
            "src/**/web/**",
            "src/**/server/**"
          ],
          "forbidUse": [
            "socket",
            "subprocess",
            "requests",
            "httpx",
            "urllib"
          ]
        }
      ],
      "functions": {
        "maxLines": 60,
        "include": [
          "src/**/*.py"
        ],
        "maxDepth": 4
      },
      "checks": [
        {
          "name": "unused",
          "command": "uv run deptry src && uv run vulture src --min-confidence 80",
          "all": true
        },
        {
          "name": "audit",
          "command": "uv run pip-audit",
          "all": true
        }
      ],
      "ratchets": [
        {
          "name": "escape hatches",
          "include": [
            "src/**/*.py"
          ],
          "patterns": [
            "#\\s*type:\\s*ignore",
            "#\\s*noqa",
            "\\bexcept\\s*:",
            "\\b(TODO|FIXME)\\b(?!.*#\\d)"
          ],
          "say": "One more way around a check (type: ignore, noqa, a bare except, a TODO with no card number): fix what the tool says, catch the error you mean, or name the card (TODO #12)"
        }
      ],
      "copies": {
        "minLines": 6,
        "tests": [
          "tests/**/test_*.py"
        ]
      }
    },
    "scripts": {
      "test": "uv run pytest -q",
      "test:full": "uv run pytest",
      "typecheck": "uv run ruff check . && uv run mypy src"
    },
    "gitignore": [
      ".venv/",
      "__pycache__/",
      ".mypy_cache/",
      ".ruff_cache/",
      ".pytest_cache/"
    ],
    "ci": [
      "- uses: astral-sh/setup-uv@v5",
      "- run: uv sync"
    ],
    "dependabot": "uv"
  },
  "go": {
    "name": "Go",
    "needs": "go",
    "config": {
      "code": [
        ".go",
        ".mjs"
      ],
      "tests": "**/*_test.go",
      "testPicking": false,
      "commands": {
        "typecheck": "go vet ./...",
        "testAll": "go test ./...",
        "testFiles": "go test ./..."
      },
      "size": {
        "maxLines": 400,
        "include": [
          "cmd/**/*.go",
          "internal/**/*.go",
          "pkg/**/*.go",
          "tools/**/*.mjs"
        ]
      },
      "functions": {
        "maxLines": 60,
        "include": [
          "cmd/**/*.go",
          "internal/**/*.go",
          "pkg/**/*.go"
        ],
        "maxDepth": 4
      },
      "boundaries": [
        {
          "name": "core is pure",
          "from": "internal/core/**",
          "forbid": [
            "internal/server/**",
            "cmd/**"
          ],
          "forbidUse": [
            "net/http",
            "os",
            "database/sql"
          ]
        }
      ],
      "roots": [
        "cmd",
        "internal",
        "pkg",
        "scripts",
        "tools"
      ],
      "map": {
        "out": "docs/MAP.md",
        "folders": [
          "cmd/**",
          "internal/**",
          "pkg/**"
        ]
      },
      "security": {
        "code": "internal/",
        "server": "internal/server/",
        "inputFolders": [
          "internal/core/",
          "internal/server/"
        ]
      },
      "checks": [
        {
          "name": "unused",
          "command": "go mod tidy -diff && go run honnef.co/go/tools/cmd/staticcheck@latest -checks U1000 ./...",
          "all": true
        },
        {
          "name": "audit",
          "command": "go run golang.org/x/vuln/cmd/govulncheck@latest ./...",
          "all": true
        }
      ],
      "ratchets": [
        {
          "name": "escape hatches",
          "include": [
            "cmd/**/*.go",
            "internal/**/*.go",
            "pkg/**/*.go"
          ],
          "patterns": [
            "//\\s*nolint",
            "\\b_ = err\\b",
            "\\bpanic\\(",
            "\\b(TODO|FIXME)\\b(?!.*#\\d)"
          ],
          "say": "One more way around a check (nolint, a dropped error, panic, a TODO with no card number): handle the error, or name the card (TODO #12)"
        }
      ],
      "copies": {
        "minLines": 6
      }
    },
    "scripts": {
      "test": "go test ./...",
      "test:full": "go test -v ./...",
      "typecheck": "go vet ./..."
    },
    "ci": [
      "- uses: actions/setup-go@v5",
      "  with:",
      "    go-version-file: go.mod"
    ],
    "dependabot": "gomod"
  }
}
