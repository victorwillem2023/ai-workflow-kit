type Graph = { imports: Map<string, Iterable<string>>; files: Map<string, string> };
export function testKey(test: string, graph: Graph, salt?: string): string;
export function cacheSalt(texts: Iterable<[string, string | null]>): string;
export function splitByCache(tests: string[], keys: Record<string, string>, passed?: Record<string, string>): { run: string[]; skipped: string[] };
export function recordPasses(passed: Record<string, string> | undefined, ran: string[], keys: Record<string, string>): Record<string, string>;
type Failure = { key: string; failure: string };
type Record_ = { passed: Record<string, string>; failed: Record<string, Failure> };
export function readRecord(text: string | null | undefined): Record_;
export function failureOf(out: string, file: string): string;
type Found = { file: string; key: string; failure: string };
export function afterRun(record: Record_, ran: string[], keys: Record<string, string>, failed: string[] | null, ok: boolean, out?: string): { record: Record_; flaky: Found[]; passedNow: string[]; failedNow: Record<string, string> };
export const CLEAR_AFTER: number;
type Flaky = Record<string, { since: string; failure: string; passes?: number }>;
export function updateFlaky(list: Flaky | undefined, found: Found[], passedNow: string[], failedNow: Record<string, string>, exists: (file: string) => boolean, today: string): Flaky;
export function flakyLines(list?: Flaky, evidence?: (file: string) => string | null): string[];
export function flakyCard(file: string, entry: { since: string; failure: string }): string;
export function failedFiles(names: string[], root: string, tests: string[]): string[];
