# Copy this file to .env and fill in what you have. .env is gitignored; never share its values.
PORT=8787
# The commit the app runs (set by the Dockerfile at build: --build-arg APP_VERSION=<commit>); /health answers with it
# APP_VERSION=dev
# The address the app's pages are served from, when it is not the server's own (the same-origin check in src/server/http.ts allows it)
# APP_ORIGIN=https://app.example.org
# How many proxies in front of the server add to x-forwarded-for (one load balancer: 1); 0 takes the connection's own address
# TRUST_PROXY=0
# The folder of the built pages the server sends (empty for none)
# PAGES_DIR=dist
